{
  "name": "brigitta-website",
  "version": "1.0.0",
  "description": "Brigitta live vocalist website and MySQL content studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install:cpanel": "node scripts/install-cpanel.mjs",
    "prebuild": "node scripts/validate-production-config.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --require=./scripts/memory-polyfill.cjs\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm run build && npm run start",
    "generate:types": "node --import tsx scripts/generate-model-types.ts",
    "ii": "npm install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "reinstall": "npm ci",
    "start": "node app.cjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed:content": "node --import tsx scripts/seed-content.ts",
    "db:migrate": "knex --knexfile knexfile.mjs migrate:latest",
    "db:status": "knex --knexfile knexfile.mjs migrate:list",
    "admin:create": "node --import tsx scripts/admin-user.ts",
    "admin:reset": "node --import tsx scripts/admin-user.ts --reset",
    "content:import": "node --import tsx scripts/import-content.ts",
    "maintenance": "node --import tsx scripts/maintenance.ts",
    "notify:inquiries": "node --import tsx scripts/dispatch-inquiry-notifications.ts",
    "test:db": "node --import tsx --test tests/mysql/*.test.ts",
    "test:import": "node --import tsx --test tests/mysql/import.test.ts"
  },
  "dependencies": {
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "knex": "^3.3.0",
    "lexical": "^0.52.0",
    "mysql2": "^3.24.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0"
}
