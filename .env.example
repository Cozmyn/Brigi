NODE_ENV=development

# Local PostgreSQL connection. Docker Compose overrides DATABASE_URL internally.
DATABASE_URL=postgres://brigitta:replace-with-a-strong-database-password@127.0.0.1:5432/brigitta
POSTGRES_USER=brigitta
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=brigitta
APP_PORT=3000

PAYLOAD_SECRET=replace-with-a-long-random-secret
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_URL=http://localhost:3000
PREVIEW_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

MEDIA_STORAGE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DEFAULT_LOCALE=ro
SUPPORTED_LOCALES=ro,en
INQUIRY_RATE_LIMIT_PER_HOUR=5
INQUIRY_RETENTION_DAYS=
PUBLIC_PHONE=
PUBLIC_WHATSAPP=
PRIVACY_OPERATOR=
PRIVACY_CONTACT=

# Set to true only after production gates G1-G7 are complete.
PRODUCTION_GATES_CLOSED=false
